# dependencies
/node_modules
apps/mobile/node_modules/

# next.js
/.next/
/out/

# production
/build

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.cursor/debug-*.log
.cursor/plans/

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
public/audio/*.wav
public/audio/*.mp3

# local deployment artifacts
logs/
.production.pid
.demo.pid

# local test and audit artifacts
screenshot-*.png
test-results/
playwright-report/
artifacts/
audit-artifacts/
.worktree-backups/
docs/audits/*.json
docs/audits/persona-reports/
docs/audits/flow-notes/*.json
# DB-008 chain-contract replay reports. The harness writes them to the repo root
# by default (supabase/tests/db008_chain_contract_replay.mjs) and regenerates
# them from the chain, so they are output rather than source. Durable evidence
# belongs under docs/engineering/verification/, per the convention above.
db008-contract-replay*.json

# macOS
.DS_Store

.bob/mcp.json

# Supabase credentials (local only)
.env.supabase.local
