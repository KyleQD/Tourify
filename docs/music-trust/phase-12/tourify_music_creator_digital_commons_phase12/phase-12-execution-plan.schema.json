{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tourify.local/schemas/phase-12-execution-plan.schema.json",
  "title": "Tourify Music Phase 12 Execution Plan",
  "type": "object",
  "required": [
    "planId",
    "version",
    "status",
    "repository",
    "hardRules",
    "featureFlags",
    "stages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "audit_required",
        "ready",
        "in_progress",
        "blocked",
        "complete"
      ]
    },
    "repository": {
      "type": "object",
      "required": [
        "commit",
        "branch"
      ],
      "properties": {
        "commit": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "hardRules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "featureFlags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "default",
          "purpose"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "default": {
            "type": "boolean"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "not_started",
        "in_progress",
        "blocked",
        "complete",
        "removed"
      ]
    },
    "stage": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "tasks"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "dependencies",
        "scope",
        "acceptanceCriteria",
        "evidence",
        "blockers",
        "filesChanged",
        "tests"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "string"
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "filesChanged": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
