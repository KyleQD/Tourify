{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tourify.local/schemas/engineering-handoff.v2.json",
  "title": "Tourify engineering handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "task_id",
    "from_agent",
    "to_agent",
    "status",
    "accepting_task_id",
    "completion_condition",
    "created_at",
    "source_sha",
    "summary",
    "working_set",
    "completed",
    "next_steps",
    "blockers",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "from_agent": {
      "type": "string"
    },
    "to_agent": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "accepted",
        "completed",
        "rejected",
        "superseded"
      ]
    },
    "accepting_task_id": {
      "type": "string"
    },
    "completion_condition": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_sha": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "working_set": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
