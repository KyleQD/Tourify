# Tourify — Vercel environment template
# Fill values, then: Vercel → Project → Settings → Environment Variables → Import
# Do not commit real secrets. Copy this file locally, fill it, import, then delete the filled copy.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Public site URLs (required for emails, redirects, Stripe return URLs) ---
# NEXT_PUBLIC_SITE_URL must match your deployed origin (no trailing slash), e.g. https://demo.tourify.live
# Supabase Dashboard → Authentication → URL Configuration:
#   - Site URL: same canonical origin as NEXT_PUBLIC_SITE_URL
#   - Additional Redirect URLs (add each host you use, including www vs apex):
#       https://YOUR_DOMAIN/auth/callback
#       https://YOUR_DOMAIN/login
#       https://YOUR_DOMAIN/dashboard
#       https://YOUR_DOMAIN/onboarding
# Email confirmation uses emailRedirectTo → /auth/callback?type=signup&redirectTo=%2Flogin (see lib/auth/auth-email-redirect.ts).
# Preview deployments: either set NEXT_PUBLIC_SITE_URL to the preview URL and whitelist it in Supabase, or disable signups on previews.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# --- Observability (optional) ---
# Sentry: server/edge use SENTRY_DSN; add NEXT_PUBLIC_SENTRY_DSN for browser errors (see docs/observability-sentry.md)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# --- Rate limits (optional; required for real limits in lib/utils/rate-limit.ts) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Notifications: Resend email ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Notifications: optional generic from (some code paths) ---
EMAIL_FROM=

# --- Notifications: Database Webhook → /api/webhooks/supabase/notifications ---
NOTIFICATION_INSERT_WEBHOOK_SECRET=

# --- Notifications: Twilio SMS (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Optional: Supabase cookie helper ---
NEXT_PUBLIC_SUPABASE_PROJECT_REF=

# --- Optional: notification debug logs ---
NOTIFICATION_DEBUG=false

# --- Your existing feature / tuning flags (already in Vercel; keep if you use them) ---
CACHE_TTL=
MAX_CONCURRENT_USER=
ENABLE_ARTIST_DISCOVERY=
ENABLE_EVENT_SYSTEM=
ENABLE_SOCIAL_SHARING=
ENABLE_HEALTH_MONITORING=

# --- Stripe (if checkout / webhooks are used) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_PHOTOS=
STRIPE_WEBHOOK_SECRET_MARKETPLACE=

# --- Cron / internal API guards (if used) ---
CRON_SECRET=
INTERNAL_API_SECRET=

# --- Redis (if caching is enabled) ---
REDIS_URL=

# --- Prisma (if direct DB URL is used) ---
DATABASE_URL=

# --- Staffing / ops (optional) ---
STAFFING_ALERT_WEBHOOK_URL=
STAFFING_ALERT_MIN_SEVERITY=critical
STAFFING_ALERT_COOLDOWN_SEC=900
STAFFING_SELF_HEAL_COOLDOWN_SEC=300
FEATURE_STAFFING_SELF_HEAL=0

# --- Workflow / RBAC feature flags (optional) ---
FEATURE_UNIFIED_WORKFLOW_THREADS=0
FEATURE_ENTITY_RBAC=0
NEXT_PUBLIC_ENABLE_VENUE_EVENT_MANAGER=false

# --- Security / vaults (optional) ---
ENCRYPTION_KEY=
EMPLOYEE_CREDENTIALS_SECRET=
ONBOARDING_CREDENTIALS_SECRET=

# --- Alternate email (optional) ---
SENDGRID_API_KEY=
EMAIL_PROVIDER_API_KEY=

# --- Contracts (optional) ---
DOCUSIGN_APP_BASE_URL=
DROPBOXSIGN_APP_BASE_URL=
PANDADOC_APP_BASE_URL=
